{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "PlaybookName": {
      "type": "string",
      "defaultValue": "Sentinel-Phishing-Triage-Playbook",
      "metadata": {
        "description": "The name of the Logic App workflow playbook."
      }
    },
    "TeamsWebhookUrl": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Incoming Webhook URL for Microsoft Teams channel alerting (leave blank to skip)."
      }
    },
    "VirusTotalApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "VirusTotal API v3 key for automated threat intelligence enrichment."
      }
    }
  },
  "variables": {
    "sentinelConnectionName": "azuresentinel-phishing-triage"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "Sentinel Managed Identity Connection",
        "customParameterValues": {},
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]"
      ],
      "properties": {
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callbackUrl": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Initialize_Triage_Verdict": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Verdict",
                    "type": "string",
                    "value": "Likely Benign"
                  },
                  {
                    "name": "RiskScore",
                    "type": "integer",
                    "value": 0
                  },
                  {
                    "name": "EnrichedEntitiesCount",
                    "type": "integer",
                    "value": 0
                  },
                  {
                    "name": "FindingsSummary",
                    "type": "string",
                    "value": "Initial Sentinel Phishing Triage Analysis initiated."
                  }
                ]
              },
              "runAfter": {}
            },
            "Evaluate_Heuristics_and_VT": {
              "type": "Scope",
              "runAfter": {
                "Initialize_Triage_Verdict": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Check_VT_Key_Provided": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "equals": [
                            "[parameters('VirusTotalApiKey')]",
                            ""
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "For_Each_Incident_Entity": {
                      "type": "Foreach",
                      "foreach": "@coalesce(triggerBody()?['object']?['properties']?['relatedEntities'], json('[]'))",
                      "actions": {
                        "Switch_Entity_Kind": {
                          "type": "Switch",
                          "expression": "@toLower(coalesce(item()?['kind'], 'unknown'))",
                          "cases": {
                            "Case_FileHash": {
                              "case": "filehash",
                              "actions": {
                                "Query_VT_FileHash": {
                                  "type": "Http",
                                  "inputs": {
                                    "method": "GET",
                                    "uri": "@concat('https://www.virustotal.com/api/v3/files/', coalesce(item()?['properties']?['fileHashValue'], item()?['properties']?['hashValue']))",
                                    "headers": {
                                      "x-apikey": "[parameters('VirusTotalApiKey')]"
                                    }
                                  },
                                  "runAfter": {}
                                },
                                "Increment_Enriched_Count_File": {
                                  "type": "IncrementVariable",
                                  "inputs": {
                                    "name": "EnrichedEntitiesCount",
                                    "value": 1
                                  },
                                  "runAfter": {
                                    "Query_VT_FileHash": [
                                      "Succeeded",
                                      "Failed"
                                    ]
                                  }
                                },
                                "Set_Verdict_Malicious_File": {
                                  "type": "SetVariable",
                                  "inputs": {
                                    "name": "Verdict",
                                    "value": "Malicious"
                                  },
                                  "runAfter": {
                                    "Increment_Enriched_Count_File": [
                                      "Succeeded"
                                    ]
                                  }
                                }
                              }
                            },
                            "Case_IP": {
                              "case": "ip",
                              "actions": {
                                "Query_VT_IP": {
                                  "type": "Http",
                                  "inputs": {
                                    "method": "GET",
                                    "uri": "@concat('https://www.virustotal.com/api/v3/ip_addresses/', item()?['properties']?['address'])",
                                    "headers": {
                                      "x-apikey": "[parameters('VirusTotalApiKey')]"
                                    }
                                  },
                                  "runAfter": {}
                                },
                                "Increment_Enriched_Count_IP": {
                                  "type": "IncrementVariable",
                                  "inputs": {
                                    "name": "EnrichedEntitiesCount",
                                    "value": 1
                                  },
                                  "runAfter": {
                                    "Query_VT_IP": [
                                      "Succeeded",
                                      "Failed"
                                    ]
                                  }
                                }
                              }
                            },
                            "Case_URL": {
                              "case": "url",
                              "actions": {
                                "Increment_Enriched_Count_URL": {
                                  "type": "IncrementVariable",
                                  "inputs": {
                                    "name": "EnrichedEntitiesCount",
                                    "value": 1
                                  },
                                  "runAfter": {}
                                }
                              }
                            }
                          },
                          "default": {
                            "actions": {}
                          },
                          "runAfter": {}
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {}
                },
                "Update_Findings_Summary": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "FindingsSummary",
                    "value": "@concat('[Automated SOAR Triage]\n- Incident: ', coalesce(triggerBody()?['object']?['properties']?['title'], 'Phishing Incident'), '\n- Severity: ', coalesce(triggerBody()?['object']?['properties']?['severity'], 'Medium'), '\n- Automated Verdict: ', variables('Verdict'), '\n- Dynamic Entities Enriched: ', string(variables('EnrichedEntitiesCount')), '\n- Threat Intel: VirusTotal v3 inspection completed across incident entities.')"
                  },
                  "runAfter": {
                    "Check_VT_Key_Provided": [
                      "Succeeded",
                      "Skipped",
                      "Failed"
                    ]
                  }
                }
              }
            },
            "Add_Incident_Comment": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/Incidents/Comment",
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "message": "@variables('FindingsSummary')"
                }
              },
              "runAfter": {
                "Evaluate_Heuristics_and_VT": [
                  "Succeeded",
                  "Failed"
                ]
              }
            },
            "Condition_Send_Teams_Notification": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "[parameters('TeamsWebhookUrl')]",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Post_Teams_Adaptive_Card": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "[parameters('TeamsWebhookUrl')]",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "type": "message",
                      "attachments": [
                        {
                          "contentType": "application/vnd.microsoft.card.adaptive",
                          "content": {
                            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                            "type": "AdaptiveCard",
                            "version": "1.4",
                            "body": [
                              {
                                "type": "TextBlock",
                                "size": "Medium",
                                "weight": "Bolder",
                                "text": "🛡️ Microsoft Sentinel SOAR Phishing Alert"
                              },
                              {
                                "type": "FactSet",
                                "facts": [
                                  {
                                    "title": "Incident Title:",
                                    "value": "@{triggerBody()?['object']?['properties']?['title']}"
                                  },
                                  {
                                    "title": "Severity:",
                                    "value": "@{triggerBody()?['object']?['properties']?['severity']}"
                                  },
                                  {
                                    "title": "Automated Verdict:",
                                    "value": "@{variables('Verdict')}"
                                  },
                                  {
                                    "title": "Entities Enriched:",
                                    "value": "@{variables('EnrichedEntitiesCount')}"
                                  },
                                  {
                                    "title": "Incident URL:",
                                    "value": "@{triggerBody()?['object']?['properties']?['incidentUrl']}"
                                  }
                                ]
                              },
                              {
                                "type": "TextBlock",
                                "text": "@{variables('FindingsSummary')}",
                                "wrap": true
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Add_Incident_Comment": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              }
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
                "connectionName": "[variables('sentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookWorkflowId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}