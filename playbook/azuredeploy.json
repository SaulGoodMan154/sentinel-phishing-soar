{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "PlaybookName": {
      "type": "string",
      "defaultValue": "Sentinel-Phishing-Triage-Playbook",
      "metadata": {
        "description": "The name of the Logic App workflow playbook."
      }
    },
    "KeyVaultName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Azure Key Vault name storing the 'VirusTotalApiKey' secret. When provided, the Logic App retrieves the secret via Managed Identity."
      }
    },
    "TeamsWebhookUrl": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Incoming Webhook URL for Microsoft Teams channel alerting (leave blank to skip)."
      }
    },
    "VirusTotalApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "VirusTotal API v3 key for threat intelligence enrichment (can be left blank if KeyVaultName is provided)."
      }
    }
  },
  "variables": {
    "sentinelConnectionName": "azuresentinel-phishing-triage"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "Sentinel Managed Identity Connection",
        "customParameterValues": {},
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]"
      ],
      "properties": {
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "KeyVaultName": {
              "type": "String",
              "defaultValue": ""
            },
            "TeamsWebhookUrl": {
              "type": "SecureString",
              "defaultValue": ""
            },
            "VirusTotalApiKey": {
              "type": "SecureString",
              "defaultValue": ""
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callbackUrl": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Initialize_Triage_Variables": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Verdict",
                    "type": "string",
                    "value": "Not enriched"
                  },
                  {
                    "name": "EnrichedEntitiesCount",
                    "type": "integer",
                    "value": 0
                  },
                  {
                    "name": "MaliciousEntityCount",
                    "type": "integer",
                    "value": 0
                  },
                  {
                    "name": "EntityFindings",
                    "type": "string",
                    "value": ""
                  },
                  {
                    "name": "FindingsSummary",
                    "type": "string",
                    "value": "Initial Sentinel Phishing Triage Analysis initiated."
                  },
                  {
                    "name": "VT_ApiKey",
                    "type": "string",
                    "value": "@parameters('VirusTotalApiKey')"
                  }
                ]
              },
              "runAfter": {}
            },
            "Resolve_VT_Key": {
              "type": "Scope",
              "runAfter": {
                "Initialize_Triage_Variables": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Check_KeyVault_Configured": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "equals": [
                            "@parameters('KeyVaultName')",
                            ""
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "Get_VT_Key_From_KeyVault": {
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "@concat('https://', parameters('KeyVaultName'), '.vault.azure.net/secrets/VirusTotalApiKey?api-version=7.4')",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://vault.azure.net"
                        }
                      },
                      "runtimeConfiguration": {
                        "secureData": {
                          "inputs": true,
                          "outputs": true
                        }
                      },
                      "runAfter": {}
                    },
                    "Set_VT_Key_From_KeyVault": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "VT_ApiKey",
                        "value": "@body('Get_VT_Key_From_KeyVault')?['value']"
                      },
                      "runAfter": {
                        "Get_VT_Key_From_KeyVault": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {}
                }
              }
            },
            "Evaluate_Heuristics_and_VT": {
              "type": "Scope",
              "runAfter": {
                "Resolve_VT_Key": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "actions": {
                "Check_VT_Key_Provided": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "equals": [
                            "@variables('VT_ApiKey')",
                            ""
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "For_Each_Incident_Entity": {
                      "type": "Foreach",
                      "foreach": "@coalesce(triggerBody()?['object']?['properties']?['relatedEntities'], json('[]'))",
                      "runtimeConfiguration": {
                        "concurrency": {
                          "repetitions": 1
                        }
                      },
                      "actions": {
                        "Switch_Entity_Kind": {
                          "type": "Switch",
                          "expression": "@toLower(coalesce(item()?['kind'], 'unknown'))",
                          "cases": {
                            "Case_FileHash": {
                              "case": "filehash",
                              "actions": {
                                "Query_VT_FileHash": {
                                  "type": "Http",
                                  "inputs": {
                                    "method": "GET",
                                    "uri": "@concat('https://www.virustotal.com/api/v3/files/', coalesce(item()?['properties']?['fileHashValue'], item()?['properties']?['hashValue']))",
                                    "headers": {
                                      "x-apikey": "@variables('VT_ApiKey')"
                                    }
                                  },
                                  "runtimeConfiguration": {
                                    "secureData": {
                                      "inputs": true,
                                      "outputs": true
                                    }
                                  },
                                  "runAfter": {}
                                },
                                "Check_VT_FileHash_Status": {
                                  "type": "If",
                                  "expression": {
                                    "and": [
                                      {
                                        "equals": [
                                          "@actions('Query_VT_FileHash')['status']",
                                          "Succeeded"
                                        ]
                                      }
                                    ]
                                  },
                                  "actions": {
                                    "Increment_Enriched_Count_File": {
                                      "type": "IncrementVariable",
                                      "inputs": {
                                        "name": "EnrichedEntitiesCount",
                                        "value": 1
                                      },
                                      "runAfter": {}
                                    },
                                    "Check_FileHash_Malicious": {
                                      "type": "If",
                                      "expression": {
                                        "and": [
                                          {
                                            "greater": [
                                              "@coalesce(body('Query_VT_FileHash')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0)",
                                              0
                                            ]
                                          }
                                        ]
                                      },
                                      "actions": {
                                        "Increment_Malicious_Count_File": {
                                          "type": "IncrementVariable",
                                          "inputs": {
                                            "name": "MaliciousEntityCount",
                                            "value": 1
                                          },
                                          "runAfter": {}
                                        }
                                      },
                                      "else": {
                                        "actions": {}
                                      },
                                      "runAfter": {
                                        "Increment_Enriched_Count_File": [
                                          "Succeeded"
                                        ]
                                      }
                                    },
                                    "Append_FileHash_Finding_Success": {
                                      "type": "AppendToStringVariable",
                                      "inputs": {
                                        "name": "EntityFindings",
                                        "value": "@concat('- FileHash ', coalesce(item()?['properties']?['fileHashValue'], item()?['properties']?['hashValue']), ': ', string(coalesce(body('Query_VT_FileHash')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0)), '/', string(add(add(add(coalesce(body('Query_VT_FileHash')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0), coalesce(body('Query_VT_FileHash')?['data']?['attributes']?['last_analysis_stats']?['suspicious'], 0)), coalesce(body('Query_VT_FileHash')?['data']?['attributes']?['last_analysis_stats']?['harmless'], 0)), coalesce(body('Query_VT_FileHash')?['data']?['attributes']?['last_analysis_stats']?['undetected'], 0))), ' engines flagged\n')"
                                      },
                                      "runAfter": {
                                        "Check_FileHash_Malicious": [
                                          "Succeeded"
                                        ]
                                      }
                                    }
                                  },
                                  "else": {
                                    "actions": {
                                      "Append_FileHash_Finding_Failed": {
                                        "type": "AppendToStringVariable",
                                        "inputs": {
                                          "name": "EntityFindings",
                                          "value": "@concat('- FileHash ', coalesce(item()?['properties']?['fileHashValue'], item()?['properties']?['hashValue']), ': VT lookup failed / not found\n')"
                                        },
                                        "runAfter": {}
                                      }
                                    }
                                  },
                                  "runAfter": {
                                    "Query_VT_FileHash": [
                                      "Succeeded",
                                      "Failed"
                                    ]
                                  }
                                }
                              }
                            },
                            "Case_IP": {
                              "case": "ip",
                              "actions": {
                                "Query_VT_IP": {
                                  "type": "Http",
                                  "inputs": {
                                    "method": "GET",
                                    "uri": "@concat('https://www.virustotal.com/api/v3/ip_addresses/', item()?['properties']?['address'])",
                                    "headers": {
                                      "x-apikey": "@variables('VT_ApiKey')"
                                    }
                                  },
                                  "runtimeConfiguration": {
                                    "secureData": {
                                      "inputs": true,
                                      "outputs": true
                                    }
                                  },
                                  "runAfter": {}
                                },
                                "Check_VT_IP_Status": {
                                  "type": "If",
                                  "expression": {
                                    "and": [
                                      {
                                        "equals": [
                                          "@actions('Query_VT_IP')['status']",
                                          "Succeeded"
                                        ]
                                      }
                                    ]
                                  },
                                  "actions": {
                                    "Increment_Enriched_Count_IP": {
                                      "type": "IncrementVariable",
                                      "inputs": {
                                        "name": "EnrichedEntitiesCount",
                                        "value": 1
                                      },
                                      "runAfter": {}
                                    },
                                    "Check_IP_Malicious": {
                                      "type": "If",
                                      "expression": {
                                        "and": [
                                          {
                                            "greater": [
                                              "@coalesce(body('Query_VT_IP')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0)",
                                              0
                                            ]
                                          }
                                        ]
                                      },
                                      "actions": {
                                        "Increment_Malicious_Count_IP": {
                                          "type": "IncrementVariable",
                                          "inputs": {
                                            "name": "MaliciousEntityCount",
                                            "value": 1
                                          },
                                          "runAfter": {}
                                        }
                                      },
                                      "else": {
                                        "actions": {}
                                      },
                                      "runAfter": {
                                        "Increment_Enriched_Count_IP": [
                                          "Succeeded"
                                        ]
                                      }
                                    },
                                    "Append_IP_Finding_Success": {
                                      "type": "AppendToStringVariable",
                                      "inputs": {
                                        "name": "EntityFindings",
                                        "value": "@concat('- IP ', coalesce(item()?['properties']?['address'], 'unknown'), ': ', string(coalesce(body('Query_VT_IP')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0)), '/', string(add(add(add(coalesce(body('Query_VT_IP')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0), coalesce(body('Query_VT_IP')?['data']?['attributes']?['last_analysis_stats']?['suspicious'], 0)), coalesce(body('Query_VT_IP')?['data']?['attributes']?['last_analysis_stats']?['harmless'], 0)), coalesce(body('Query_VT_IP')?['data']?['attributes']?['last_analysis_stats']?['undetected'], 0))), ' engines flagged\n')"
                                      },
                                      "runAfter": {
                                        "Check_IP_Malicious": [
                                          "Succeeded"
                                        ]
                                      }
                                    }
                                  },
                                  "else": {
                                    "actions": {
                                      "Append_IP_Finding_Failed": {
                                        "type": "AppendToStringVariable",
                                        "inputs": {
                                          "name": "EntityFindings",
                                          "value": "@concat('- IP ', coalesce(item()?['properties']?['address'], 'unknown'), ': VT lookup failed / not found\n')"
                                        },
                                        "runAfter": {}
                                      }
                                    }
                                  },
                                  "runAfter": {
                                    "Query_VT_IP": [
                                      "Succeeded",
                                      "Failed"
                                    ]
                                  }
                                }
                              }
                            },
                            "Case_URL": {
                              "case": "url",
                              "actions": {
                                "Query_VT_URL": {
                                  "type": "Http",
                                  "inputs": {
                                    "method": "GET",
                                    "uri": "@concat('https://www.virustotal.com/api/v3/urls/', replace(replace(replace(base64(coalesce(item()?['properties']?['url'], '')), '+', '-'), '/', '_'), '=', ''))",
                                    "headers": {
                                      "x-apikey": "@variables('VT_ApiKey')"
                                    }
                                  },
                                  "runtimeConfiguration": {
                                    "secureData": {
                                      "inputs": true,
                                      "outputs": true
                                    }
                                  },
                                  "runAfter": {}
                                },
                                "Check_VT_URL_Status": {
                                  "type": "If",
                                  "expression": {
                                    "and": [
                                      {
                                        "equals": [
                                          "@actions('Query_VT_URL')['status']",
                                          "Succeeded"
                                        ]
                                      }
                                    ]
                                  },
                                  "actions": {
                                    "Increment_Enriched_Count_URL": {
                                      "type": "IncrementVariable",
                                      "inputs": {
                                        "name": "EnrichedEntitiesCount",
                                        "value": 1
                                      },
                                      "runAfter": {}
                                    },
                                    "Check_URL_Malicious": {
                                      "type": "If",
                                      "expression": {
                                        "and": [
                                          {
                                            "greater": [
                                              "@coalesce(body('Query_VT_URL')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0)",
                                              0
                                            ]
                                          }
                                        ]
                                      },
                                      "actions": {
                                        "Increment_Malicious_Count_URL": {
                                          "type": "IncrementVariable",
                                          "inputs": {
                                            "name": "MaliciousEntityCount",
                                            "value": 1
                                          },
                                          "runAfter": {}
                                        }
                                      },
                                      "else": {
                                        "actions": {}
                                      },
                                      "runAfter": {
                                        "Increment_Enriched_Count_URL": [
                                          "Succeeded"
                                        ]
                                      }
                                    },
                                    "Append_URL_Finding_Success": {
                                      "type": "AppendToStringVariable",
                                      "inputs": {
                                        "name": "EntityFindings",
                                        "value": "@concat('- URL ', coalesce(item()?['properties']?['url'], 'unknown'), ': ', string(coalesce(body('Query_VT_URL')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0)), '/', string(add(add(add(coalesce(body('Query_VT_URL')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0), coalesce(body('Query_VT_URL')?['data']?['attributes']?['last_analysis_stats']?['suspicious'], 0)), coalesce(body('Query_VT_URL')?['data']?['attributes']?['last_analysis_stats']?['harmless'], 0)), coalesce(body('Query_VT_URL')?['data']?['attributes']?['last_analysis_stats']?['undetected'], 0))), ' engines flagged\n')"
                                      },
                                      "runAfter": {
                                        "Check_URL_Malicious": [
                                          "Succeeded"
                                        ]
                                      }
                                    }
                                  },
                                  "else": {
                                    "actions": {
                                      "Append_URL_Finding_Failed": {
                                        "type": "AppendToStringVariable",
                                        "inputs": {
                                          "name": "EntityFindings",
                                          "value": "@concat('- URL ', coalesce(item()?['properties']?['url'], 'unknown'), ': VT lookup failed / not found\n')"
                                        },
                                        "runAfter": {}
                                      }
                                    }
                                  },
                                  "runAfter": {
                                    "Query_VT_URL": [
                                      "Succeeded",
                                      "Failed"
                                    ]
                                  }
                                }
                              }
                            }
                          },
                          "default": {
                            "actions": {}
                          },
                          "runAfter": {}
                        }
                      },
                      "runAfter": {}
                    },
                    "Set_Triage_Verdict": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "Verdict",
                        "value": "@if(greater(variables('MaliciousEntityCount'), 0), 'Malicious', if(greater(variables('EnrichedEntitiesCount'), 0), 'Likely Benign', 'Not enriched'))"
                      },
                      "runAfter": {
                        "For_Each_Incident_Entity": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Update_Findings_Summary": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "FindingsSummary",
                        "value": "@concat('[Automated SOAR Triage]\n- Incident: ', coalesce(triggerBody()?['object']?['properties']?['title'], 'Phishing Incident'), '\n- Severity: ', coalesce(triggerBody()?['object']?['properties']?['severity'], 'Medium'), '\n- Automated Verdict: ', variables('Verdict'), '\n- Entities enriched: ', string(variables('EnrichedEntitiesCount')), ', flagged malicious: ', string(variables('MaliciousEntityCount')), if(empty(variables('EntityFindings')), '', concat('\n\nEntity Findings:\n', variables('EntityFindings'))))"
                      },
                      "runAfter": {
                        "Set_Triage_Verdict": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Set_Verdict_Not_Enriched": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "Verdict",
                          "value": "Not enriched"
                        },
                        "runAfter": {}
                      },
                      "Update_Findings_Summary_No_Key": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "FindingsSummary",
                          "value": "@concat('[Automated SOAR Triage]\n- Incident: ', coalesce(triggerBody()?['object']?['properties']?['title'], 'Phishing Incident'), '\n- Severity: ', coalesce(triggerBody()?['object']?['properties']?['severity'], 'Medium'), '\n- Automated Verdict: ', variables('Verdict'), '\n- VirusTotal enrichment skipped: no API key configured')"
                        },
                        "runAfter": {
                          "Set_Verdict_Not_Enriched": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {}
                }
              }
            },
            "Add_Incident_Comment": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/Incidents/Comment",
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "message": "@variables('FindingsSummary')"
                }
              },
              "runAfter": {
                "Evaluate_Heuristics_and_VT": [
                  "Succeeded",
                  "Failed"
                ]
              }
            },
            "Condition_Send_Teams_Notification": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@parameters('TeamsWebhookUrl')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Post_Teams_Adaptive_Card": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('TeamsWebhookUrl')",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "type": "message",
                      "attachments": [
                        {
                          "contentType": "application/vnd.microsoft.card.adaptive",
                          "content": {
                            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                            "type": "AdaptiveCard",
                            "version": "1.4",
                            "body": [
                              {
                                "type": "TextBlock",
                                "size": "Medium",
                                "weight": "Bolder",
                                "text": "🛡️ Microsoft Sentinel SOAR Phishing Alert"
                              },
                              {
                                "type": "FactSet",
                                "facts": [
                                  {
                                    "title": "Incident Title:",
                                    "value": "@{coalesce(triggerBody()?['object']?['properties']?['title'], 'Phishing Incident')}"
                                  },
                                  {
                                    "title": "Severity:",
                                    "value": "@{coalesce(triggerBody()?['object']?['properties']?['severity'], 'Medium')}"
                                  },
                                  {
                                    "title": "Automated Verdict:",
                                    "value": "@{variables('Verdict')}"
                                  },
                                  {
                                    "title": "Entities Enriched:",
                                    "value": "@{string(variables('EnrichedEntitiesCount'))}"
                                  },
                                  {
                                    "title": "Entities Flagged:",
                                    "value": "@{string(variables('MaliciousEntityCount'))}"
                                  },
                                  {
                                    "title": "Incident URL:",
                                    "value": "@{coalesce(triggerBody()?['object']?['properties']?['incidentUrl'], 'N/A')}"
                                  }
                                ]
                              },
                              {
                                "type": "TextBlock",
                                "text": "@{variables('FindingsSummary')}",
                                "wrap": true
                              }
                            ],
                            "actions": [
                              {
                                "type": "Action.OpenUrl",
                                "title": "Open incident",
                                "url": "@{coalesce(triggerBody()?['object']?['properties']?['incidentUrl'], 'https://portal.azure.com')}"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "inputs": true,
                      "outputs": true
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Add_Incident_Comment": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              }
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
                "connectionName": "[variables('sentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
              }
            }
          },
          "KeyVaultName": {
            "value": "[parameters('KeyVaultName')]"
          },
          "TeamsWebhookUrl": {
            "value": "[parameters('TeamsWebhookUrl')]"
          },
          "VirusTotalApiKey": {
            "value": "[parameters('VirusTotalApiKey')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookWorkflowId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
